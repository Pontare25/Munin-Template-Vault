filters:
  and:
    - type == "project" || type == "area"
properties:
  note.date_created:
    displayName: Created
views:
  - type: table
    name: Active
    filters:
      and:
        - status == "active" || status == "waiting"
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - type
      - status
      - date_created
  - type: table
    name: All efforts
    filters:
      and:
        - '!file.path.startsWith("Archive/")'
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - type
      - status
      - date_created
  - type: table
    name: Archive
    filters:
      and:
        - file.path.startsWith("Archive/")
    order:
      - file.name
      - type
      - status
      - date_end
      - summary
    sort:
      - property: date_end
        direction: DESC
