filters:
  and:
    - file.path.startsWith("Calendar")
formulas:
  week: date(date).format("[W]WW")
  day: date(date).format("ddd")
  quarter: date(date).format("[Q]Q")
views:
  - type: table
    name: Weekly-rollup
    filters:
      and:
        - type == "daily"
        - date >= this.date
        - date < this.date + "7d"
    order:
      - file.name
      - summary
    sort:
      - property: date
        direction: ASC
    columnSize:
      file.name: 235
      note.summary: 616
    rowHeight: tall
  - type: table
    name: Monthly-rollup
    filters:
      and:
        - type == "weekly"
        - date >= this.date
        - date < this.date + "1 month"
    order:
      - file.name
      - summary
    sort:
      - property: date
        direction: ASC
    columnSize:
      file.name: 235
      note.summary: 616
    rowHeight: medium
  - type: table
    name: Monthly-daily-rollup
    filters:
      and:
        - type == "daily"
        - date >= this.date
        - date < this.date + "1 month"
    groupBy:
      property: formula.week
      direction: ASC
    order:
      - file.name
      - summary
    sort:
      - property: date
        direction: ASC
    columnSize:
      file.name: 93
      note.summary: 920
    rowHeight: medium
  - type: table
    name: Quarterly-rollup
    filters:
      and:
        - type == "monthly"
        - date >= this.date
        - date < this.date + "3 months"
    order:
      - file.name
      - summary
    sort:
      - property: date
        direction: ASC
    columnSize:
      file.name: 235
      note.summary: 616
    rowHeight: medium
  - type: table
    name: Yearly-rollup
    filters:
      and:
        - type == "quarterly"
        - date >= this.date
        - date < this.date + "1 year"
    order:
      - file.name
      - summary
    sort:
      - property: date
        direction: ASC
    columnSize:
      file.name: 235
      note.summary: 616
    rowHeight: medium
  - type: table
    name: Yearly-months-rollup
    filters:
      and:
        - type == "monthly"
        - date >= this.date
        - date < this.date + "1 year"
    groupBy:
      property: formula.quarter
      direction: ASC
    order:
      - file.name
      - summary
    sort:
      - property: date
        direction: ASC
    columnSize:
      file.name: 93
      note.summary: 920
    rowHeight: medium
