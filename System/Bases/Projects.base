filters:
  and:
    - type == "project"
properties:
  note.date_due:
    displayName: Due
views:
  - type: table
    name: All Projects
    filters:
      and:
        - '!file.path.startsWith("Archive/")'
  - type: table
    name: Learning
    filters:
      and:
        - '!file.path.startsWith("Archive/")'
        - list(area).contains(link("Learning")) || file.path.startsWith("Efforts/Learning/")
    order:
      - file.name
      - status
      - related
      - summary
  - type: kanban
    name: Sub projects
    filters:
      and:
        - up.contains(link(this.file))
        - file.path != this.file.path
    groupBy:
      property: status
      direction: ASC
    groupOrder:
      - backlog
      - active
      - waiting
      - done
      - dropped
    order:
      - file.name
      - summary
      - date_due
      - status
    sort:
      - property: date_due
        direction: DESC
    columnSize:
      file.name: 189
      note.status: 97
      note.summary: 629
    columnWidth: 340
    imageAspectRatio: 0.7
  - type: table
    name: Related learning
    filters:
      and:
        - list(related).contains(link(this.file))
        - list(area).contains(link("Learning")) || file.path.startsWith("Efforts/Learning/")
    order:
      - file.name
      - status
      - summary
  - type: table
    name: Archive
    filters:
      and:
        - file.path.startsWith("Archive/")
    order:
      - file.name
      - status
      - date_end
      - summary
    sort:
      - property: date_end
        direction: DESC
