formulas:
  linked_from: file.backlinks.length
  links_out: file.links.length
properties:
  formula.linked_from:
    displayName: Linked from
  formula.links_out:
    displayName: Links out
views:
  - type: table
    name: All notes
  - type: table
    name: AI notes awaiting review
    filters:
      and:
        - ai == "pending"
    order:
      - file.name
      - type
      - summary
      - date_created
    sort:
      - property: date_created
        direction: ASC
  - type: table
    name: Child notes
    filters:
      and:
        - up.contains(link(this.file))
        - '!type.containsAny("project", "task", "meeting", "work-session")'
    order:
      - file.name
      - summary
      - type
    sort:
      - property: summary
        direction: ASC
    columnSize:
      file.name: 195
      note.summary: 807
  - type: table
    name: Related notes
    filters:
      and:
        - related.contains(link(this.file))
    order:
      - file.name
      - summary
      - type
    columnSize:
      file.name: 184
      note.summary: 811
  - type: table
    name: No up
    filters:
      and:
        - '["note", "framework", "source"].contains(type)'
        - up.isEmpty()
    order:
      - file.name
      - type
      - formula.linked_from
      - formula.links_out
      - date_created
    sort:
      - property: formula.linked_from
        direction: DESC
      - property: formula.links_out
        direction: DESC
