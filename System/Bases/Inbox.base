filters:
  and:
    - file.path.startsWith("Raw/Inbox")
    - '!file.name.contains("README")'
formulas:
  waiting: 'if(note.date_created, (now() - note.date_created).days.round(0), (now() - file.ctime).days.round(0))'
  captured: 'if(note.date_created, note.date_created.format("YYYY-MM-DD"), file.ctime.format("YYYY-MM-DD"))'
properties:
  formula.waiting:
    displayName: Days waiting
  formula.captured:
    displayName: Captured
  file.ext:
    displayName: Kind
  note.date_created:
    displayName: Created
views:
  - type: table
    name: Awaiting analysis
    order:
      - file.name
      - file.ext
      - formula.waiting
      - summary
      - formula.captured
    sort:
      - property: formula.waiting
        direction: DESC
    columnSize:
      file.name: 340
      note.summary: 460
