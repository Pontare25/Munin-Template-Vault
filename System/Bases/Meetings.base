filters:
  or:
    - type == "meeting"
formulas:
  week: date(date).format("[W]WW")
  day: date(date).format("dddd")
views:
  - type: table
    name: Project meetings
    filters:
      and:
        - up.contains(link(this.file))
    groupBy:
      property: formula.week
      direction: DESC
    order:
      - type
      - file.name
      - summary
      - up
      - people
    sort:
      - property: date
        direction: DESC
    columnSize:
      file.name: 153
      note.type: 89
      note.summary: 440
      note.up: 154
    rowHeight: medium
  - type: table
    name: Daily meeting rollup
    filters:
      and:
        - date >= this.date
        - date < this.date + "1d"
    order:
      - file.name
      - up
      - summary
      - people
    sort:
      - property: date
        direction: ASC
    columnSize:
      file.name: 235
      note.up: 155
      note.summary: 500
    rowHeight: tall
  - type: table
    name: People meetings
    filters:
      and:
        - people.contains(link(this.file))
    groupBy:
      property: formula.week
      direction: DESC
    order:
      - file.name
      - summary
      - up
      - people
    sort:
      - property: date
        direction: DESC
    columnSize:
      file.name: 173
      note.summary: 458
      note.up: 250
    rowHeight: medium
  - type: table
    name: Weekly meeting rollup
    filters:
      and:
        - date >= this.date
        - date < this.date + "7d"
    groupBy:
      property: date
      direction: ASC
    order:
      - file.name
      - up
      - summary
      - people
    sort:
      - property: date
        direction: ASC
    columnSize:
      file.name: 235
      note.up: 155
      note.summary: 616
    rowHeight: tall
  - type: table
    name: Monthly meeting rollup
    filters:
      and:
        - date >= this.date
        - date < this.date + "1 month"
    groupBy:
      property: formula.week
      direction: ASC
    order:
      - file.name
      - up
      - summary
      - people
    sort:
      - property: date
        direction: ASC
    columnSize:
      file.name: 235
      note.up: 155
      note.summary: 616
    rowHeight: medium
