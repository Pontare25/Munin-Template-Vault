filters:
  and:
    - type == "meeting"
formulas:
  week: date(date).format("[W]WW")
  day: date(date).format("dddd")
views:
  - type: table
    name: Project meetings
    filters:
      and:
        - file.links.contains(this.file)
    groupBy:
      property: formula.week
      direction: DESC
    order:
      - file.name
      - summary
      - date
      - up
      - attendees
    sort:
      - property: date
        direction: DESC
    columnSize:
      file.name: 235
      note.summary: 303
      note.up: 250
    rowHeight: medium
  - type: table
    name: Daily meeting rollup
    filters:
      and:
        - date >= this.date
        - date < this.date + "1d"
    order:
      - file.name
      - up
      - summary
      - attendees
    sort:
      - property: date
        direction: ASC
    columnSize:
      file.name: 235
      note.up: 155
      note.summary: 500
    rowHeight: tall
  - type: table
    name: Attendee meetings
    filters:
      and:
        - attendees.contains(this.file)
    groupBy:
      property: formula.week
      direction: DESC
    order:
      - file.name
      - summary
      - date
      - up
      - attendees
    sort:
      - property: date
        direction: DESC
    columnSize:
      file.name: 235
      note.summary: 303
      note.up: 250
    rowHeight: medium
  - type: table
    name: Weekly meeting rollup
    filters:
      and:
        - date >= this.date
        - date < this.date + "7d"
    groupBy:
      property: date
      direction: ASC
    order:
      - file.name
      - up
      - summary
      - attendees
    sort:
      - property: date
        direction: ASC
    columnSize:
      file.name: 235
      note.up: 155
      note.summary: 616
    rowHeight: tall
  - type: table
    name: Monthly meeting rollup
    filters:
      and:
        - date >= this.date
        - date < this.date + "1 month"
    groupBy:
      property: formula.week
      direction: ASC
    order:
      - file.name
      - up
      - summary
      - attendees
    sort:
      - property: date
        direction: ASC
    columnSize:
      file.name: 235
      note.up: 155
      note.summary: 616
    rowHeight: medium
