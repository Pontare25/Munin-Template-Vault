filters:
  or:
    - type == "meeting"
    - type == "work-session"
formulas:
  week: date(date_start).format("[W]WW")
properties:
  note.date_start:
    displayName: Start
  note.summary:
    displayName: Summary
  note.details:
    displayName: Details
  note.actions:
    displayName: Actions
views:
  - type: table
    name: Project meetings and work sessions
    filters:
      and:
        - up.contains(link(this.file))
    groupBy:
      property: formula.week
      direction: DESC
    order:
      - type
      - file.name
      - summary
      - people
    sort:
      - property: date_start
        direction: DESC
    columnSize:
      note.type: 110
      file.name: 220
      note.summary: 560
    rowHeight: medium
  - type: table
    name: Project meetings
    filters:
      and:
        - type == "meeting"
        - up.contains(link(this.file))
    groupBy:
      property: formula.week
      direction: DESC
    order:
      - type
      - file.name
      - summary
      - up
      - people
    sort:
      - property: date_start
        direction: DESC
    columnSize:
      note.type: 89
      file.name: 197
      note.summary: 622
      note.up: 209
    rowHeight: medium
  - type: table
    name: Project meetings detailed
    filters:
      and:
        - type == "meeting"
        - up.contains(link(this.file))
    groupBy:
      property: formula.week
      direction: DESC
    order:
      - file.name
      - summary
      - details
      - actions
      - people
    sort:
      - property: date_start
        direction: DESC
    columnSize:
      file.name: 153
      note.summary: 260
      note.details: 360
      note.actions: 260
    rowHeight: extra
  - type: table
    name: Project work sessions detailed
    filters:
      and:
        - type == "work-session"
        - up.contains(link(this.file))
    groupBy:
      property: formula.week
      direction: DESC
    order:
      - file.name
      - date_start
      - summary
      - people
    sort:
      - property: date_start
        direction: DESC
    columnSize:
      file.name: 200
      note.summary: 560
    rowHeight: extra
  - type: table
    name: People meetings
    filters:
      and:
        - type == "meeting"
        - people.contains(link(this.file))
    groupBy:
      property: formula.week
      direction: DESC
    order:
      - file.name
      - summary
      - up
      - people
    sort:
      - property: date_start
        direction: DESC
    columnSize:
      file.name: 173
      note.summary: 458
      note.up: 250
    rowHeight: medium
  - type: table
    name: People meetings detailed
    filters:
      and:
        - type == "meeting"
        - people.contains(link(this.file))
    groupBy:
      property: formula.week
      direction: DESC
    order:
      - file.name
      - summary
      - details
      - actions
      - up
    sort:
      - property: date_start
        direction: DESC
    columnSize:
      file.name: 173
      note.summary: 260
      note.details: 360
      note.actions: 260
    rowHeight: extra
