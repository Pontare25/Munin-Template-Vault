filters:
  or:
    - type == "meeting"
formulas:
  week: date(date).format("[W]WW")
views:
  - type: table
    name: Project meetings
    filters:
      and:
        - up.contains(link(this.file))
    groupBy:
      property: formula.week
      direction: DESC
    order:
      - type
      - file.name
      - summary
      - up
      - people
    sort:
      - property: date
        direction: DESC
    columnSize:
      file.name: 153
      note.type: 89
      note.summary: 440
      note.up: 154
    rowHeight: medium
  - type: table
    name: People meetings
    filters:
      and:
        - people.contains(link(this.file))
    groupBy:
      property: formula.week
      direction: DESC
    order:
      - file.name
      - summary
      - up
      - people
    sort:
      - property: date
        direction: DESC
    columnSize:
      file.name: 173
      note.summary: 458
      note.up: 250
    rowHeight: medium
