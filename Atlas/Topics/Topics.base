filters:
  and:
    - 'type == "topic"'
formulas:
  notes_linking_in: 'file.backlinks.length'
properties:
  formula.notes_linking_in:
    displayName: "Linked from"
  note.date_created:
    displayName: Created
views:
  - type: table
    name: "All topics"
    order:
      - file.name
      - formula.notes_linking_in
      - date_created
  - type: table
    name: "Stubs"
    filters:
      and:
        - 'up.isEmpty() && related.isEmpty() && down.isEmpty() && opposes.isEmpty()'
        - 'formula.notes_linking_in >= 3'
    order:
      - file.name
      - formula.notes_linking_in
      - date_created
    sort:
      - property: formula.notes_linking_in
        direction: DESC
